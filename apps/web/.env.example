# HausCrawl — public Supabase configuration
#
# Copy this file to apps/web/.env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
# These two values are public by design (they ship in the browser bundle);
# Row Level Security is what protects data. Never put the database password
# in this file. The service role key below is server-only and must never be
# exposed with a NEXT_PUBLIC_* name or imported by a client component.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=[YOUR_CONTACT_EMAIL]

# Waitlist-only mode. Local/preview: false. Production: true (see docs/WAITLIST.md).
WAITLIST_ONLY=false

# Server-only secrets. Generate each with `openssl rand -hex 32`.
# Never commit real values.
WAITLIST_IP_SALT=replace-with-a-long-random-value
WAITLIST_UNSUBSCRIBE_SECRET=replace-with-a-different-long-random-value
WAITLIST_CONFIRMATION_SECRET=replace-with-a-third-long-random-value
# Signs the waitlist survey links. Without it the survey page reports that it is
# unavailable and the status page hides the survey prompt.
WAITLIST_SURVEY_SECRET=replace-with-a-fourth-long-random-value

# Server-only: waitlist RPCs, confirmation/delivery, and mirroring each new
# waitlist email into Authentication → Users. Never expose this to the browser.
# Required in production; development can fall back, but Auth mirroring, positions
# and referrals stay off.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Resend confirmation and status email. The form works with this
# disabled, but positions and referral UI stay hidden until it is ready.
WAITLIST_EMAIL_ENABLED=false
RESEND_API_KEY=
WAITLIST_EMAIL_FROM="HausCrawl <hello@your-domain.example>"

# Optional: PostHog analytics. Public project key only; leave blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
